<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 30;
    gap: 16;
    background-color: rgba(10, 0, 0, 0.94);
    border-radius: 16;
    border-width: 2;
    border-color: rgba(255, 170, 50, 0.6);
    width: 380;
  }
  .title {
    font-size: 36;
    color: #ffcc44;
  }
  .subtitle {
    font-size: 14;
    color: rgba(255, 200, 100, 0.7);
  }
  .btn {
    padding: 12;
    background-color: rgba(200, 120, 30, 0.25);
    border-radius: 8;
    width: 280;
    align-items: center;
    cursor: pointer;
    border-width: 1;
    border-color: rgba(255, 170, 50, 0.4);
  }
  .btn-text {
