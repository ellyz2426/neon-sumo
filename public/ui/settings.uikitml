<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 24;
    gap: 10;
    background-color: rgba(10, 0, 0, 0.94);
    border-radius: 16;
    border-width: 2;
    border-color: rgba(255, 170, 50, 0.6);
    width: 400;
  }
  .title {
    font-size: 24;
    color: #ffcc44;
  }
  .label {
    font-size: 14;
    color: rgba(200, 180, 140, 0.8);
  }
  .row {
    flex-direction: row;
    gap: 8;
    align-items: center;
  }
  .btn {
    padding: 8;
    background-color: rgba(200, 120, 30, 0.25);
    border-radius: 6;
    align-items: center;
    cursor: pointer;
    border-width: 1;
    border-color: rgba(255, 170, 50, 0.4);
    width: 90;
  }
  .btn-sm {
    padding: 6;
    background-color: rgba(200, 120, 30, 0.2);
    border-radius: 4;
    align-items: center;
    cursor: pointer;
    border-width: 1;
    border-color: rgba(255, 170, 50, 0.3);
    width: 70;
  }
  .btn-text {
    font-size: 13;
    color: #ffdd88;
  }
  .btn-text-sm {
    font-size: 11;
    color: #ffdd88;
  }
  .section {
    flex-direction: column;
    gap: 6;
    width: 360;
  }
  .section-title {
    font-size: 16;
    color: #ffaa44;
  }
  .back-btn {
    padding: 10;
    background-color: rgba(200, 120, 30, 0.25);
    border-radius: 8;
    width: 180;
    align-items: center;
    cursor: pointer;
    border-width: 1;
    border-color: rgba(255, 170, 50, 0.4);
  }
</style>
<Panel class="root">
  <div class="title">SETTINGS</div>

  <div class="section">
    <div class="section-title">Difficulty</div>
    <div class="label" id="diff-label">Difficulty: Normal</div>
    <div class="row">
      <div class="btn" id="btn-easy">
        <div class="btn-text">Easy</div>
      </div>
      <div class="btn" id="btn-normal">
        <div class="btn-text">Normal</div>
      </div>
      <div class="btn" id="btn-hard">
        <div class="btn-text">Hard</div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Theme</div>
    <div class="label" id="scheme-label">Theme: Dohyo Classic</div>
    <div class="row">
      <div class="btn-sm" id="btn-scheme0">
        <div class="btn-text-sm">Classic</div>
      </div>
      <div class="btn-sm" id="btn-scheme1">
        <div class="btn-text-sm">Neon</div>
      </div>
      <div class="btn-sm" id="btn-scheme2">
        <div class="btn-text-sm">Blossom</div>
      </div>
      <div class="btn-sm" id="btn-scheme3">
        <div class="btn-text-sm">Thunder</div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Audio</div>
    <div class="row">
      <div class="btn" id="btn-sfx">
        <div class="btn-text" id="sfx-label">SFX: ON</div>
      </div>
      <div class="btn" id="btn-music">
        <div class="btn-text" id="music-label">Music: ON</div>
      </div>
    </div>
  </div>

  <div class="back-btn" id="btn-back">
    <div class="btn-text">BACK</div>
  </div>
</Panel>
