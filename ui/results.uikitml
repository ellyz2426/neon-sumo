<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 24;
    gap: 8;
    background-color: rgba(10, 0, 0, 0.94);
    border-radius: 16;
    border-width: 2;
    border-color: rgba(255, 170, 50, 0.6);
    width: 400;
  }
  .title {
    font-size: 32;
    color: #ffcc44;
  }
  .technique {
    font-size: 20;
    color: #ff9944;
  }
  .stat {
    font-size: 15;
    color: rgba(220, 200, 160, 0.9);
  }
  .highlight {
    font-size: 17;
    color: #ff8844;
  }
  .rivalry {
    font-size: 13;
    color: rgba(255, 180, 80, 0.8);
  }
  .combo {
    font-size: 16;
    color: #ff44ff;
  }
  .upset {
    font-size: 16;
    color: #ffdd44;
  }
  .btn {
    padding: 12;
    background-color: rgba(200, 120, 30, 0.25);
    border-radius: 8;
    width: 220;
    align-items: center;
    cursor: pointer;
    border-width: 1;
    border-color: rgba(255, 170, 50, 0.4);
  }
  .btn-text {
    font-size: 16;
    color: #ffdd88;
  }
  .row {
    flex-direction: row;
    gap: 16;
  }
  .divider {
    height: 1;
    width: 340;
    background-color: rgba(255, 170, 50, 0.3);
  }
  .tourney-result {
    font-size: 14;
    color: #ffaa88;
  }
  .champion {
    font-size: 24;
    color: #ffdd44;
  }
  .match-stat-label {
    font-size: 11;
    color: rgba(180, 170, 140, 0.7);
  }
  .match-stat-row {
    flex-direction: row;
    justify-content: space-between;
    width: 340;
  }
  .match-stat-value {
    font-size: 11;
    color: rgba(200, 190, 160, 0.8);
  }
  .section-title {
    font-size: 13;
    color: #ffaa44;
    width: 340;
  }
  .danger-stat {
    font-size: 11;
    color: rgba(255, 120, 80, 0.7);
  }
</style>
<Panel class="root">
  <div class="title" id="result-title">VICTORY!</div>
  <div class="technique" id="result-technique">Kimarite: Oshidashi</div>
  <div class="combo" id="result-combo"></div>
  <div class="upset" id="upset-text"></div>
  <div class="divider"></div>
  <div class="tourney-result" id="tourney-result"></div>
  <div class="champion" id="champion-text"></div>
  <div class="highlight" id="result-opponent">Opponent: TARO</div>
  <div class="rivalry" id="result-rivalry"></div>
  <div class="stat" id="result-score">Score: 0</div>
  <div class="stat" id="result-rank">Rank: Jonokuchi</div>
  <div class="stat" id="result-record">Record: 0W - 0L</div>
  <div class="stat" id="result-streak">Win Streak: 0</div>
  <div class="divider"></div>
  <div class="section-title">Match Breakdown</div>
  <div class="match-stat-row">
    <div class="match-stat-label">Match Time</div>
    <div class="match-stat-value" id="match-time-stat">0s</div>
  </div>
  <div class="match-stat-row">
    <div class="match-stat-label">Pushes / Grabs / Dodges</div>
    <div class="match-stat-value" id="match-attacks-stat">0 / 0 / 0</div>
  </div>
  <div class="match-stat-row">
    <div class="match-stat-label">Charges / Henkas</div>
    <div class="match-stat-value" id="match-specials-stat">0 / 0</div>
  </div>
  <div class="match-stat-row">
    <div class="match-stat-label">Best Combo</div>
    <div class="match-stat-value" id="match-combo-stat">0</div>
  </div>
  <div class="danger-stat" id="match-danger-stat"></div>
  <div class="row">
    <div class="btn" id="btn-next">
      <div class="btn-text">NEXT MATCH</div>
    </div>
    <div class="btn" id="btn-menu">
      <div class="btn-text">MENU</div>
    </div>
  </div>
</Panel>
